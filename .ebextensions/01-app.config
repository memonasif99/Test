# Elastic Beanstalk settings for Doha Fresh Mart.
option_settings:
  aws:elasticbeanstalk:environment:
    # The app stores data in a JSON file on the instance, so run exactly one
    # instance (no load balancer). Move to a real database before scaling out.
    EnvironmentType: SingleInstance
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    # Kept outside the app folder so orders survive redeployments.
    DB_FILE: /var/app/data/db.json
